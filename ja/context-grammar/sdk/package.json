{
  "name": "@context-grammar/core",
  "version": "1.0.0-alpha.1",
  "description": "Context Grammar — rule engine for the 8 Context Tokens and 23 AX Patterns. A design language for agentic AI products.",
  "keywords": [
    "context-grammar",
    "agentic-ai",
    "design-system",
    "ux",
    "ax-patterns",
    "autonomy",
    "disclosure"
  ],
  "homepage": "https://intentfirst.ai/context-grammar/",
  "repository": {
    "type": "git",
    "url": "https://github.com/intentfirst/context-grammar"
  },
  "license": "CC-BY-4.0",
  "author": {
    "name": "Takao Umehara",
    "url": "https://intentfirst.ai/about"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./patterns": {
      "types": "./dist/patterns.d.ts",
      "import": "./dist/patterns.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test src/**/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
